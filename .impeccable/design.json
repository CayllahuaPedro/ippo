  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single filled violet action per view.",
      "html": "<button class=\"ds-btn-primary\">Continue reading</button>",
      "css": ".ds-btn-primary{background:var(--color-accent,#6b5ce7);color:var(--color-on-accent,#fff);border:1px solid var(--color-accent,#6b5ce7);border-radius:var(--radius-control,8px);padding:10px 18px;font:400 15px/1.55 Figtree,system-ui,sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-btn-primary:hover{background:var(--color-accent-hover,#5a4bd6);border-color:var(--color-accent-hover,#5a4bd6)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-accent,#6b5ce7);outline-offset:2px}.ds-btn-primary:disabled{background:var(--color-wash,#f7f7fa);border-color:var(--color-hairline,#e6e7ee);color:var(--color-muted,#4b5165);cursor:default}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary action beside a primary one.",
      "html": "<button class=\"ds-btn-outline\">Ask the tutor</button>",
      "css": ".ds-btn-outline{background:var(--color-ground,#fff);color:var(--color-accent,#6b5ce7);border:1px solid var(--color-accent,#6b5ce7);border-radius:var(--radius-control,8px);padding:10px 20px;font:400 15px/1.55 Figtree,system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-outline:hover{background:var(--color-tint,#efedfc)}.ds-btn-outline:focus-visible{outline:2px solid var(--color-accent,#6b5ce7);outline-offset:2px}"
    },
    {
      "name": "Suggestion Chip",
      "kind": "chip",
      "refersTo": "chip-suggestion",
      "description": "Prompt suggestions above the tutor composer.",
