      "css": ".ds-chip{background:var(--color-ground,#fff);color:var(--color-ink,#1b1547);border:1px solid var(--color-hairline,#e6e7ee);border-radius:var(--radius-control,8px);padding:8px 14px;font:400 14px/1.55 Figtree,system-ui,sans-serif;cursor:pointer;transition:color .15s,border-color .15s}.ds-chip:hover{border-color:var(--color-accent,#6b5ce7);color:var(--color-accent,#6b5ce7)}.ds-chip:focus-visible{outline:2px solid var(--color-accent,#6b5ce7);outline-offset:2px}"
    },
    {
      "name": "Tutor Composer",
      "kind": "input",
      "refersTo": "input-composer",
      "description": "Hairline field with an inline violet send button.",
      "html": "<form class=\"ds-composer\"><input class=\"ds-composer-input\" placeholder=\"Ask about this passage\"><button type=\"button\" class=\"ds-composer-send\" aria-label=\"Send\"><svg viewBox=\"0 0 20 20\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 16V4M5 9l5-5 5 5\"/></svg></button></form>",
      "css": ".ds-composer{display:flex;align-items:center;gap:8px;background:var(--color-ground,#fff);border:1px solid var(--color-hairline,#e6e7ee);border-radius:var(--radius-control,8px);padding:6px 6px 6px 16px;transition:border-color .15s,box-shadow .15s}.ds-composer:focus-within{border-color:var(--color-accent,#6b5ce7);box-shadow:0 0 0 1px var(--color-accent,#6b5ce7)}.ds-composer-input{flex:1;min-width:0;border:0;background:transparent;color:var(--color-ink,#1b1547);font:400 16px/1.55 Figtree,system-ui,sans-serif;outline:none}.ds-composer-input::placeholder{color:var(--color-faint,#636880)}.ds-composer-send{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border:0;border-radius:var(--radius-control,8px);background:var(--color-accent,#6b5ce7);color:var(--color-on-accent,#fff);cursor:pointer}.ds-composer-send:hover{background:var(--color-accent-hover,#5a4bd6)}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented-selected",
      "description": "Radio group for display settings; selected segment is tint with an inset violet ring.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button class=\"ds-seg-opt\" aria-checked=\"true\">Learn</button><button class=\"ds-seg-opt\" aria-checked=\"false\">Book</button><button class=\"ds-seg-opt\" aria-checked=\"false\">Compact</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:2px;border:1px solid var(--color-hairline,#e6e7ee);border-radius:var(--radius-control,8px);background:var(--color-ground,#fff)}.ds-seg-opt{border:0;background:none;padding:8px 16px;border-radius:6px;font:400 15px/1.55 Figtree,system-ui,sans-serif;color:var(--color-muted,#4b5165);cursor:pointer;transition:color .15s,background-color .15s}.ds-seg-opt:hover{color:var(--color-ink,#1b1547)}.ds-seg-opt[aria-checked=true]{background:var(--color-tint,#efedfc);color:var(--color-ink,#1b1547);font-weight:500;box-shadow:inset 0 0 0 1px var(--color-accent,#6b5ce7)}.ds-seg-opt:focus-visible{outline:2px solid var(--color-accent,#6b5ce7);outline-offset:2px}"
    },
    {
      "name": "Header Navigation",
      "kind": "nav",
      "refersTo": "header-bar",
      "description": "Sticky 72px bar: mark, section links with a violet current underline, the theme toggle (40px icon button, the only theme control), one filled action.",
      "html": "<header class=\"ds-nav\"><span class=\"ds-nav-mark\">Nihon AI</span><nav class=\"ds-nav-links\"><span class=\"ds-nav-soon\">SRS <em>soon</em></span><a href=\"#\" class=\"ds-nav-link\" aria-current=\"page\">Reader</a><a href=\"#\" class=\"ds-nav-link\">Discover</a><a href=\"#\" class=\"ds-nav-link\">Tutor</a></nav><span style=\"flex:1\"></span><a href=\"#\" class=\"ds-nav-action\">Find your next read</a></header>",
      "css": ".ds-nav{display:flex;align-items:center;gap:40px;height:72px;padding:0 48px;background:var(--color-ground,#fff);border-bottom:1px solid var(--color-hairline,#e6e7ee);font-family:Figtree,system-ui,sans-serif;color:var(--color-ink,#1b1547)}.ds-nav-mark{font-size:19px;font-weight:500}.ds-nav-links{display:flex;align-self:stretch;gap:28px}.ds-nav-link,.ds-nav-soon{position:relative;display:flex;align-items:center;gap:6px;font-size:15px;text-decoration:none;color:var(--color-muted,#4b5165);transition:color .15s}.ds-nav-link:hover{color:var(--color-ink,#1b1547)}.ds-nav-link[aria-current=page]{color:var(--color-ink,#1b1547);font-weight:500}.ds-nav-link[aria-current=page]::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--color-accent,#6b5ce7)}.ds-nav-soon{color:var(--color-faint,#636880)}.ds-nav-soon em{font-style:normal;font-size:12px;line-height:1.4;padding:0 4px;border:1px solid var(--color-hairline,#e6e7ee);border-radius:4px}.ds-nav-action{background:var(--color-accent,#6b5ce7);color:var(--color-on-accent,#fff);border-radius:var(--radius-control,8px);padding:10px 18px;font-size:15px;text-decoration:none;transition:background-color .15s}.ds-nav-action:hover{background:var(--color-accent-hover,#5a4bd6)}.ds-nav-link:focus-visible,.ds-nav-action:focus-visible{outline:2px solid var(--color-accent,#6b5ce7);outline-offset:2px}"
    },
    {
      "name": "Forecast Block",
      "kind": "custom",
      "refersTo": "forecast-track",
      "description": "Signature: tabular percentage over an uncertainty band; the only place colour is spent.",
      "html": "<div class=\"ds-forecast\"><p class=\"ds-forecast-num\">78%</p><div class=\"ds-forecast-track\"><span class=\"ds-forecast-band\" style=\"left:66%;width:22%\"></span><span class=\"ds-forecast-tick\" style=\"left:78%\"></span></div><p class=\"ds-forecast-cap\">you'll understand · likely 66–88%</p></div>",
      "css": ".ds-forecast{display:flex;flex-direction:column;font-family:Figtree,system-ui,sans-serif;color:var(--color-ink,#1b1547)}.ds-forecast-num{margin:0;font-size:72px;line-height:1;font-weight:500;letter-spacing:-0.03em;font-variant-numeric:tabular-nums}.ds-forecast-track{position:relative;margin-top:16px;height:12px;width:100%;max-width:320px;background:var(--color-track,#f4f5f7)}.ds-forecast-band{position:absolute;top:0;bottom:0;background:linear-gradient(90deg,var(--color-forecast-low,#7fd8d0),var(--color-forecast-mid,#c9b8f0),var(--color-forecast-high,#5b4fd6))}.ds-forecast-tick{position:absolute;top:-4px;bottom:-4px;width:2px;transform:translateX(-50%);background:var(--color-ink,#1b1547)}.ds-forecast-cap{margin:10px 0 0;font-size:15px;color:var(--color-muted,#4b5165);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Word Marks",
      "kind": "custom",
      "refersTo": "",
      "description": "Signature: word state by underline style; known none, learning dotted 2px, selected solid 3px over tint.",
      "html": "<p class=\"ds-words\" lang=\"ja\"><span>今日</span>は<span class=\"ds-word-learning\">図書館</span>で<span class=\"ds-word-selected\">本</span>を読みました。</p>",
      "css": ".ds-words{font-family:'Zen Kaku Gothic New','Hiragino Sans','Noto Sans JP',sans-serif;font-size:23px;line-height:2.3;color:var(--color-ink,#1b1547)}.ds-word-learning{text-decoration:underline dotted var(--color-accent,#6b5ce7) 2px;text-underline-offset:0.32em}.ds-word-selected{background:var(--color-tint,#efedfc);text-decoration:underline solid var(--color-accent,#6b5ce7) 3px;text-underline-offset:0.32em;border-radius:3px}"
    },
    {
      "name": "Recommendation Card",
      "kind": "card",
      "refersTo": "panel",
      "description": "12px hairline panel with a Japanese title, a forecast, and a hairline-ruled metadata list. No shadow.",
      "html": "<article class=\"ds-card\"><h3 class=\"ds-card-title\" lang=\"ja\">走れメロス</h3><p class=\"ds-card-num\">71%</p><dl class=\"ds-card-meta\"><dt>Format</dt><dd>Story · 12 min</dd><dt>Source</dt><dd>Aozora Bunko</dd></dl></article>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:20px;padding:20px;background:var(--color-ground,#fff);border:1px solid var(--color-hairline,#e6e7ee);border-radius:var(--radius-panel,12px);color:var(--color-ink,#1b1547);font-family:Figtree,system-ui,sans-serif}.ds-card-title{margin:0;font-family:'Zen Kaku Gothic New','Hiragino Sans',sans-serif;font-size:21px;line-height:1.4;font-weight:500}.ds-card-num{margin:0;font-size:44px;line-height:1;font-weight:500;letter-spacing:-0.03em;font-variant-numeric:tabular-nums}.ds-card-meta{display:grid;grid-template-columns:72px 1fr;gap:6px 16px;margin:0;padding-top:16px;border-top:1px solid var(--color-hairline,#e6e7ee);font-size:15px}.ds-card-meta dt{color:var(--color-muted,#4b5165)}.ds-card-meta dd{margin:0}"
    }
  ],
  "narrative": {
    "northStar": "The Civic Prospectus",
    "overview": "A plain, trustworthy bureau document about one question: how much of this text will you understand? Everything on the page is ink on a white (or deep indigo) ground, ruled with 1px hairlines, set in a quiet humanist sans for English and Zen Kaku Gothic New for Japanese. The only place the page spends colour is the comprehension forecast: a large tabular percentage above an uncertainty band that runs teal to lilac to violet. Violet otherwise appears only where you can act.\n\nDensity is calm and editorial. The reading column is held to about 36 Japanese characters with generous line height so furigana has room above the line. Surfaces are flat and separated by hairlines rather than fills; a panel is a 12px-radius hairline box, never a card inside a card. Elevation is reserved for things that float over the text: the word popup, the floating action on phones, and the bottom sheet.\n\nDark is a token swap, never a component fork: the same world at night on a deep indigo ground (#14122b), reached by an explicit theme choice or by the system preference when no choice was made. The world refuses the JLPT-badge-on-a-card arrangement and the warm \"Japan app\" palette; the text's own level is stated in muted metadata, kept apart from the personal forecast.",
    "keyCharacteristics": [
      "Ink (never pure black) on white; deep indigo ground in dark.",
      "Colour budget: the forecast gradient, plus the violet interactive accent.",
      "1px hairlines as the main structural device; two radii only (8px controls, 12px panels).",
      "Figtree 400/500 for UI, Zen Kaku Gothic New 400/500 for Japanese; no bold anywhere.",
      "Word state carried by underline style (none, dotted, solid), not by hue.",
      "One shadow token, used only on elements that float above the text."
    ],
    "rules": [
      {
        "name": "The Forecast Spends the Colour Rule",
        "body": "The teal-lilac-violet gradient appears only inside the forecast band. If a surface has colour that is neither the forecast nor something you can act on, it is wrong.",
        "section": "colors"
      },
      {
        "name": "The One Violet Rule",
        "body": "Violet means \"interactive\" or \"your current state\". It is never decoration, never a heading colour, never a background panel.",
        "section": "colors"
      },
      {
        "name": "The Token Swap Rule",
        "body": "Dark mode changes token values only. A component never branches on theme.",
        "section": "colors"
      },
      {
        "name": "The Medium Ceiling Rule",
        "body": "Only weights 400 and 500 are loaded and used. Emphasis is 500 plus ink colour; nothing is bold.",
        "section": "typography"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Every percentage, range and count is set with tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Only-What-Floats Rule",
        "body": "A shadow means \"this sits above the text and will go away\". Cards, panels in the layout flow and the header never carry one.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep colour to the forecast gradient and the violet accent; everything else is ink, muted, faint and hairline.",
      "Do state the text's own level (\"Text level N4\") as muted metadata, separate from the personal forecast.",
      "Do mark word state with underline style (none, dotted 2px, solid 3px), so it survives colour-vision differences.",
      "Do use 8px for controls and 12px for panels, with 1px hairline borders.",
      "Do set every number tabular, and cap weight at 500.",
      "Do define both a light and a dark value for any new colour token and swap them at the root.",
      "Do honour reduced motion; all animation and transition collapses to near zero."
    ],
    "donts": [
      "Don't put a JLPT badge on a card or tint a card by level.",
      "Don't use warm \"Japan app\" palettes (reds, cream, terracotta) or pure black text.",
      "Don't nest a card inside a card.",
      "Don't use the forecast gradient anywhere outside the forecast band.",
      "Don't add shadows to anything that sits in the layout flow.",
      "Don't fork a component for dark mode."
    ]
  }
}